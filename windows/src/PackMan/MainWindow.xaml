<ui:FluentWindow x:Class="PackMan.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:PackMan.Models"
        xmlns:services="clr-namespace:PackMan.Services"
        Title="PackMan" Width="1020" Height="680" MinWidth="820" MinHeight="540"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
        Icon="pack://application:,,,/Assets/app.ico">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanConverter xmlns:local="clr-namespace:PackMan" x:Key="InverseBool" />
        <local:InverseBooleanToVisibilityConverter xmlns:local="clr-namespace:PackMan" x:Key="InverseBoolToVis" />
        <local:BindingProxy xmlns:local="clr-namespace:PackMan" x:Key="VmProxy" Data="{Binding}" />
    </ui:FluentWindow.Resources>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="PackMan" Icon="pack://application:,,,/Assets/app.ico" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="16,10,16,8" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:Button AutomationProperties.AutomationId="scanCancelButton" Command="{Binding ScanOrCancelCommand}" MinWidth="92" Padding="16,7" Margin="0,0,8,0"
                               ToolTip="Scan enabled sources or cancel the active operation">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="18" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding ScanButtonText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button AutomationProperties.AutomationId="updateSelectedButton" Command="{Binding UpdateSelectedCommand}" Content="{Binding UpdateButtonText}"
                               Appearance="Primary" MinWidth="128" Padding="16,7" Margin="0,0,10,0"
                               ToolTip="Update all checked packages" />
                    <Menu Background="Transparent" VerticalAlignment="Center">
                        <MenuItem Header="Selection">
                            <MenuItem Header="Select All Updates" Command="{Binding SelectAllCommand}" />
                            <MenuItem Header="Select None" Command="{Binding SelectNoneCommand}" />
                        </MenuItem>
                        <MenuItem Header="Activity" AutomationProperties.AutomationId="activityMenu">
                            <MenuItem Header="Package details" AutomationProperties.AutomationId="detailsMenuItem" Click="Details_Click" />
                            <MenuItem Header="Update history" AutomationProperties.AutomationId="historyMenuItem" Click="History_Click" />
                            <MenuItem Header="Export redacted diagnostics" Command="{Binding ExportDiagnosticsCommand}" />
                        </MenuItem>
                        <MenuItem Header="Help">
                            <MenuItem Header="Check for Updates" Command="{Binding CheckForUpdatesCommand}" />
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ui:Button AutomationProperties.AutomationId="detailsButton" Content="Details" Click="Details_Click" Padding="13,7" Margin="0,0,8,0" />
                    <ui:Button AutomationProperties.AutomationId="sourcesButton" Content="Sources" Click="Sources_Click" Padding="13,7" Margin="0,0,8,0"
                               ToolTip="Configure package sources and executables" />
                    <ui:Button Content="{Binding LogButtonText}" Command="{Binding ToggleLogCommand}" Padding="13,7"
                               ToolTip="Show or hide the command log" />
                </StackPanel>
            </DockPanel>

            <Border AutomationProperties.AutomationId="appUpdateBanner" Grid.Row="1" Background="#2260A5FA" Padding="16,8"
                    Visibility="{Binding ShowAppUpdateBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="&#x2B07;" Foreground="#FF60A5FA" FontSize="17" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppUpdateText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <ui:Button AutomationProperties.AutomationId="installUpdateButton" Content="Install and Restart"
                                   Command="{Binding InstallUpdateCommand}" Appearance="Primary" Margin="8,0,0,0" />
                        <ui:Button AutomationProperties.AutomationId="skipUpdateButton" Content="Skip"
                                   Command="{Binding SkipUpdateCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border AutomationProperties.AutomationId="scanIssueBanner" Grid.Row="2" Background="#22F59E0B" Padding="16,8"
                    Visibility="{Binding ShowIssueBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="⚠" Foreground="#FFF59E0B" FontSize="17" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <ui:Button Content="Retry Issues" Command="{Binding RetryIssuesCommand}" Margin="8,0" />
                        <ui:Button Content="Sources" Click="Sources_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="3" Margin="16,2,16,8" Padding="10" CornerRadius="6"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Visibility="{Binding ShowSourceProgress, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding SourceOptions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="9,6" MinWidth="205" CornerRadius="5"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text="{Binding ElapsedText, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid Grid.Row="4" Margin="16,0,16,8">
                <DataGrid x:Name="UpdatesGrid" AutomationProperties.AutomationId="updatesTable" ItemsSource="{Binding PackagesView}"
                          Visibility="{Binding HasPackages, Converter={StaticResource BoolToVis}}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeight="34" ColumnHeaderHeight="36"
                          IsReadOnly="True" AlternatingRowBackground="#08000000">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Package details" Command="{Binding Data.ShowPackageDetailsCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}" />
                                        <MenuItem Header="Verify again" Command="{Binding Data.VerifyAgainCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}" />
                                        <MenuItem Header="Update / Retry" Command="{Binding Data.UpdateSingleCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}" />
                                        <MenuItem Header="Retry as administrator" Command="{Binding Data.RetryElevatedCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Ignore This Update" Command="{Binding Data.IgnoreUpdateVersionCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}" />
                                        <MenuItem Header="Ignore Package (All Versions)" Command="{Binding Data.IgnorePackageCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Copy Package ID" Command="{Binding Data.CopyPackageIdCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Select" Width="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}"
                                              IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBool}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" SortMemberPath="Source" Width="110" />
                        <DataGridTextColumn Header="Current" Binding="{Binding CurrentVersion}" SortMemberPath="CurrentVersion" Width="*" />
                        <DataGridTextColumn Header="Available" Binding="{Binding AvailableVersion}" SortMemberPath="AvailableVersion" Width="*" />
                        <DataGridTemplateColumn Header="Status" SortMemberPath="StatusTitle" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusTitle}" ToolTip="{Binding StatusMessage}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:UpdateStatus.Failed}"><Setter Property="Foreground" Value="#FFFF5F56" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:UpdateStatus.Updating}"><Setter Property="Foreground" Value="#FF60A5FA" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:UpdateStatus.Verifying}"><Setter Property="Foreground" Value="#FF60A5FA" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:UpdateStatus.Cancelled}"><Setter Property="Foreground" Value="#FFF59E0B" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480"
                            Visibility="{Binding HasPackages, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="◫" FontSize="46" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,6" />
                    <TextBlock Text="{Binding EmptyDescription}" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button Content="Scan" Command="{Binding ScanOrCancelCommand}" Appearance="Primary"
                               HorizontalAlignment="Center" Padding="18,7" Margin="0,16,0,0" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Row="5" Height="5" HorizontalAlignment="Stretch" Background="Transparent"
                          Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVis}}" />
            <Border Grid.Row="6" Height="180" Margin="16,0,16,8" Padding="8" CornerRadius="6"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,2,6">
                        <TextBlock Text="Command Log" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <CheckBox x:Name="FollowLogCheck" Content="Follow latest" IsChecked="True" Margin="18,0,0,0" VerticalAlignment="Center" />
                        <ui:Button Content="Copy" Command="{Binding CopyLogCommand}" Margin="12,0,6,0" Padding="8,2" />
                        <ui:Button Content="Clear" Command="{Binding ClearLogCommand}" Padding="8,2" />
                    </StackPanel>
                    <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Warning}"><Setter Property="Foreground" Value="#FFF59E0B" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Error}"><Setter Property="Foreground" Value="#FFFF5F56" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Success}"><Setter Property="Foreground" Value="#FF34D399" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="7">
                <DockPanel Margin="16,4" Visibility="{Binding HasUpdateSummary, Converter={StaticResource BoolToVis}}">
                    <ui:Button DockPanel.Dock="Right" Content="Retry failed" Command="{Binding RetryFailedCommand}" />
                    <TextBlock Text="{Binding UpdateSummaryText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            <StatusBar>
                <TextBlock Text="{Binding StatusText}" Margin="8,2" />
                <Separator />
                <TextBlock Text="{Binding SourceIssueCount, StringFormat='{}{0} source issues'}" Margin="8,2"
                           Foreground="#FFF59E0B" Visibility="{Binding HasSourceIssues, Converter={StaticResource BoolToVis}}" />
                <StatusBarItem HorizontalAlignment="Right"><TextBlock Text="{Binding VersionText}" FontSize="11" Margin="8,2"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="PackMan version" /></StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right"><TextBlock Text="{Binding FooterText}" Margin="8,2" /></StatusBarItem>
            </StatusBar>
            </StackPanel>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
