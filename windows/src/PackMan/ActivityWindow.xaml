<ui:FluentWindow x:Class="PackMan.ActivityWindow" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:PackMan"
    Title="PackMan Activity" Width="900" Height="710" MinWidth="650" MinHeight="500"
    WindowStartupLocation="CenterOwner" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanConverter x:Key="InverseBool" />
    </ui:FluentWindow.Resources>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Package details and history" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8">
            <ui:Button Content="Cancel operation" Command="{Binding CancelOperationCommand}" IsEnabled="{Binding IsBusy}" Margin="0,0,8,0" />
            <ui:Button Content="Export redacted diagnostics" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Close" Click="Close_Click" />
        </StackPanel>
        <TabControl x:Name="ActivityTabs" Margin="16,8">
            <TabItem Header="Package details">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Select a package in the updates table to inspect it." TextWrapping="Wrap" Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPackage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel DataContext="{Binding SelectedPackage}">
                            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" />
                            <TextBox Text="{Binding PackageId, Mode=OneWay}" IsReadOnly="True" Margin="0,8" AutomationProperties.AutomationId="packageDetailId" />
                            <TextBlock Text="{Binding RepositoryText, StringFormat='Source / repository: {0}'}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentVersion, StringFormat='Last observed installed version: {0}'}" Margin="0,5" />
                            <TextBlock Text="{Binding AvailableVersion, StringFormat='Requested: {0}'}" />
                            <TextBox Text="{Binding ToolPath, Mode=OneWay}" IsReadOnly="True" Margin="0,8" />
                            <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ScanWarning}" TextWrapping="Wrap" Margin="0,5" />
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding VerificationEvidence}" TextWrapping="Wrap" Margin="0,5" />
                            <TextBlock Text="{Binding Restart, StringFormat='Restart: {0}'}" />
                            <TextBlock Text="{Binding MetadataStatus}" TextWrapping="Wrap" Margin="0,5" />
                        </StackPanel>
                        <WrapPanel Margin="0,14" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <ui:Button Content="Update / retry install" Command="{Binding RetryUpdateCommand}" CommandParameter="{Binding SelectedPackage}"
                                IsEnabled="{Binding SelectedPackage.IsActionable}" Margin="0,0,8,8" />
                            <ui:Button Content="Verify again" AutomationProperties.AutomationId="verifyAgainButton"
                                Command="{Binding VerifyAgainCommand}" CommandParameter="{Binding SelectedPackage}" Margin="0,0,8,8"
                                IsEnabled="{Binding SelectedPackage.HasExactIdentity}" />
                            <ui:Button Content="Interactive installer" Command="{Binding UpdateInteractiveCommand}" CommandParameter="{Binding SelectedPackage}"
                                IsEnabled="{Binding SelectedPackage.IsActionable}" Visibility="{Binding SelectedPackage.SupportsInteractive, Converter={StaticResource BoolToVis}}" Margin="0,0,8,8" />
                            <ui:Button Content="Package page" Command="{Binding OpenPackagePageCommand}" CommandParameter="{Binding SelectedPackage}" Margin="0,0,8,8" />
                            <ui:Button Content="Load publisher / release links" Command="{Binding LoadPackageLinksCommand}" CommandParameter="{Binding SelectedPackage}"
                                IsEnabled="{Binding SelectedPackage.SupportsMetadata}" Margin="0,0,8,8" />
                            <ui:Button Content="Publisher" Command="{Binding OpenMetadataLinkCommand}" CommandParameter="{Binding SelectedPackage.PublisherUrl}" Margin="0,0,8,8" />
                            <ui:Button Content="Release notes" Command="{Binding OpenMetadataLinkCommand}" CommandParameter="{Binding SelectedPackage.ReleaseNotesUrl}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Text="Package command output" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedPackage.CommandOutput, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                            FontFamily="Consolas" MinHeight="140" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,8" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="History">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="180" /></Grid.RowDefinitions>
                    <TextBlock Text="The latest 500 update attempts are kept on this computer. Select a row for details."
                        TextWrapping="Wrap" Margin="0,0,0,10" />
                    <DataGrid x:Name="HistoryTable" Grid.Row="1" AutomationProperties.AutomationId="historyTable"
                        ItemsSource="{Binding HistoryEntries}" AutoGenerateColumns="False" IsReadOnly="True"
                        CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Started" Binding="{Binding StartedAt, StringFormat=g}" Width="150" />
                            <DataGridTextColumn Header="Package" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="95" />
                            <DataGridTextColumn Header="Outcome" Binding="{Binding OutcomeText}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox Grid.Row="2" Text="{Binding SelectedItem.Details, ElementName=HistoryTable, Mode=OneWay}"
                        IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</ui:FluentWindow>
