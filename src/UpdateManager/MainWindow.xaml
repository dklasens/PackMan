<ui:FluentWindow x:Class="UpdateManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Update Manager"
        Width="980" Height="640"
        MinWidth="760" MinHeight="480"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="pack://application:,,,/Assets/app.ico">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top"
                     Title="Update Manager"
                     Icon="pack://application:,,,/Assets/app.ico" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="140" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="16,8,16,4">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:Button Content="Scan"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding ScanCommand}"
                               Margin="0,0,8,0"
                               Padding="16,6" />
                    <ui:Button Content="Update Selected"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Command="{Binding UpdateSelectedCommand}"
                               Appearance="Primary"
                               Padding="16,6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right">
                    <ui:Button Content="All"
                               Command="{Binding SelectAllCommand}"
                               Appearance="Secondary"
                               Padding="12,4"
                               Margin="0,0,6,0" />
                    <ui:Button Content="None"
                               Command="{Binding SelectNoneCommand}"
                               Appearance="Secondary"
                               Padding="12,4"
                               Margin="0,0,12,0" />
                </StackPanel>
                <ProgressBar Height="4"
                             VerticalAlignment="Center"
                             IsIndeterminate="{Binding IsBusy}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </DockPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,16,4">
                <TextBlock Text="Sources:"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding SourceOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsEnabled}"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <DataGrid Grid.Row="2"
                      Margin="16,0,16,8"
                      ItemsSource="{Binding PackagesView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="30"
                      ColumnHeaderHeight="34"
                      ScrollViewer.CanContentScroll="False"
                      IsReadOnly="False">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header=""
                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="40" />
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        IsReadOnly="True"
                                        Width="2*" />
                    <DataGridTextColumn Header="Source"
                                        Binding="{Binding Source}"
                                        IsReadOnly="True"
                                        Width="80" />
                    <DataGridTextColumn Header="Current"
                                        Binding="{Binding CurrentVersion}"
                                        IsReadOnly="True"
                                        Width="*" />
                    <DataGridTextColumn Header="Available"
                                        Binding="{Binding AvailableVersion}"
                                        IsReadOnly="True"
                                        Width="*" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        IsReadOnly="True"
                                        Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Row="3" Margin="16,0,16,8" Header="Log">
                <ListBox x:Name="LogList"
                         ItemsSource="{Binding LogLines}"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Consolas"
                         FontSize="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </GroupBox>

            <StatusBar Grid.Row="4">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusText}" Margin="8,2" />
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Packages.Count, StringFormat='{}{0} update(s)'}" Margin="8,2" />
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
